{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "cypress"]
  },
  "include": [
    "playwright.config.ts",
    "cypress.config.ts",
    "shared/**/*.ts",
    "frameworks/playwright/**/*.ts",
    "frameworks/cypress/**/*.ts"
  ]
}
